{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zyta.app/schemas/change-brief/v0.4.json",
  "title": "ChangeBrief",
  "type": "object",
  "required": [
    "version",
    "workSource",
    "mergeRequest",
    "oneLiner",
    "requirementSummary",
    "integration",
    "agentConsiderations",
    "worthMentioning",
    "humanValidation",
    "planBaseline",
    "implementationChronicle",
    "scope",
    "requirementsTraceability",
    "behavior",
    "humanAttention",
    "humanChecklist",
    "qualityAgentSummary"
  ],
  "properties": {
    "version": { "const": "0.4" },
    "status": { "enum": ["draft", "ready_for_human"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "chronicleSource": {
      "enum": ["file", "baking", "none", "synthetic"],
      "description": "Provenance of implementationChronicle"
    },
    "workSource": {
      "type": "object",
      "required": ["kind", "ref", "title"],
      "properties": {
        "kind": { "enum": ["jira", "spec"] },
        "ref": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "specPath": { "type": "string" },
        "specRevision": { "type": "string" }
      }
    },
    "mergeRequest": {
      "type": "object",
      "required": ["repo", "number", "url", "baseSha", "headSha"],
      "properties": {
        "repo": { "type": "string" },
        "number": { "type": "integer" },
        "url": { "type": "string", "format": "uri" },
        "baseSha": { "type": "string" },
        "headSha": { "type": "string" }
      }
    },
    "oneLiner": { "type": "string", "maxLength": 400 },
    "requirementSummary": { "type": "string", "maxLength": 1200 },
    "integration": {
      "type": "object",
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string", "maxLength": 1200 },
        "mermaid": { "type": "string", "maxLength": 8000 },
        "mermaidSequence": { "type": "string", "maxLength": 8000 },
        "touchpoints": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "protocol": { "type": "string" },
              "notes": { "type": "string", "maxLength": 280 }
            }
          }
        }
      }
    },
    "agentConsiderations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["question", "resolution"],
        "properties": {
          "question": { "type": "string", "maxLength": 400 },
          "resolution": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "worthMentioning": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "type": "string" }
    },
    "humanValidation": {
      "type": "object",
      "required": ["correctSignals", "redFlags", "quickChecks"],
      "properties": {
        "headline": { "type": "string", "maxLength": 500 },
        "correctSignals": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "type": "string" }
        },
        "redFlags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string" }
        },
        "quickChecks": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["action", "passIf"],
            "properties": {
              "action": { "type": "string", "maxLength": 350 },
              "passIf": { "type": "string", "maxLength": 350 }
            }
          }
        }
      }
    },
    "planBaseline": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 8
    },
    "implementationChronicle": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["seq", "type", "whatHappened", "decisionOrConsequence"],
        "properties": {
          "seq": { "type": "integer", "minimum": 1 },
          "type": {
            "enum": ["plan", "discovery", "pivot", "decision", "scope_change", "blocker"]
          },
          "whatHappened": { "type": "string", "maxLength": 400 },
          "decisionOrConsequence": { "type": "string", "maxLength": 400 }
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["expected", "actual", "reason"],
        "properties": {
          "expected": { "type": "string" },
          "actual": { "type": "string" },
          "reason": { "type": "string" },
          "acceptableForMerge": { "type": "boolean" }
        }
      }
    },
    "globalView": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["capabilityOrLayer", "roleInMr"],
        "properties": {
          "capabilityOrLayer": { "type": "string" },
          "roleInMr": { "type": "string", "maxLength": 280 },
          "notes": { "type": "string" }
        }
      }
    },
    "anchorPoints": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string" }
    },
    "scope": {
      "type": "object",
      "required": ["areas", "inScope", "outOfScope"],
      "properties": {
        "areas": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["name", "summary"],
            "properties": {
              "name": { "type": "string" },
              "summary": { "type": "string", "maxLength": 280 }
            }
          }
        },
        "inScope": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
        "outOfScope": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
        "followUp": { "type": "array", "items": { "type": "string" } }
      }
    },
    "requirementsTraceability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion", "status", "evidence"],
        "properties": {
          "criterion": { "type": "string" },
          "sourceRef": { "type": "string" },
          "status": { "enum": ["met", "partial", "not_met", "na", "out_of_scope"] },
          "evidence": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "behavior": {
      "type": "object",
      "required": ["before", "after"],
      "properties": {
        "before": { "type": "string" },
        "after": { "type": "string" },
        "featureFlags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "default": { "type": "string" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "blastRadius": {
      "type": "object",
      "properties": {
        "usersRoles": { "type": "string" },
        "data": { "type": "string" },
        "integrations": { "type": "string" },
        "deployNotes": { "type": "string" }
      }
    },
    "multiRepo": {
      "type": "object",
      "properties": {
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repo": { "type": "string" },
              "mr": { "type": "string" },
              "role": { "type": "string" }
            }
          }
        },
        "mergeOrder": { "type": "string" }
      }
    },
    "humanAttention": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "maxItems": 7
    },
    "deepDives": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["title", "body"],
        "properties": {
          "title": { "type": "string" },
          "body": { "type": "string", "maxLength": 1200 }
        }
      }
    },
    "qualityAgentSummary": {
      "type": "object",
      "required": ["coveredByAgent", "openFindingsCount"],
      "properties": {
        "coveredByAgent": { "type": "array", "items": { "type": "string" }, "maxItems": 6 },
        "openFindingsCount": { "type": "integer", "minimum": 0 },
        "reviewUrl": { "type": "string", "format": "uri" }
      }
    },
    "humanChecklist": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 4,
      "maxItems": 7
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "confidence": {
      "type": "object",
      "properties": {
        "overall": { "enum": ["high", "medium", "low"] },
        "notes": { "type": "string" }
      }
    }
  }
}
